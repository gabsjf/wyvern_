# Caddy: HTTPS automático (Let's Encrypt), WebSocket e uploads grandes sem configuração extra.
# DOMAIN vem do .env (ex.: wyvern.sbs).

{$DOMAIN} {
	root * /srv/front
	encode zstd gzip
	header {
		# Começa em Report-Only (só registra violações no console). Depois de navegar pelo app sem avisos,
		# troque o nome do cabeçalho para Content-Security-Policy. Mantenha em sincronia com nginx.conf e o <meta> do index.html.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' blob: data: https://api.{$DOMAIN}; connect-src 'self' https://api.{$DOMAIN} wss://api.{$DOMAIN} https://o4512408863899648.ingest.us.sentry.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	try_files {path} /index.html
	file_server
}

api.{$DOMAIN} {
	encode zstd gzip
	# Mapas sobem até 8 MB; o Caddy não limita por padrão, mas deixamos explícito.
	request_body {
		max_size 12MB
	}
	# O reverse_proxy já repassa Upgrade/Connection (SignalR: /cenahub, /mesahub, /combathub).
	reverse_proxy api:8080
}

# www -> domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
