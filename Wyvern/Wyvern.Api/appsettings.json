{
  "Database": {
    "Provider": "Postgres"
  },
  "Jwt": {
    "Issuer": "WyvernApi",
    "Audience": "WyvernFront",
    "ExpiresMinutes": 15,
    "RefreshDays": 30
  },
  "Login": {
    "TentativasAntesDoBloqueio": 5,
    "BloqueioInicialSegundos": 30,
    "BloqueioMaximoSegundos": 900
  },
  "Email": {
    "Porta": 587,
    "NomeRemetente": "Wyvern"
  },
  "Cors": {
    "AllowedOrigins": [ "https://wyvern.sbs", "https://www.wyvern.sbs", "https://localhost", "capacitor://localhost" ]
  },
  "Admin": {
    "Emails": []
  },
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0
  },
  "Planos": {
    "Beta": true,
    "Catalogo": {
      "Free": { "Nome": "Free", "MaxCampanhas": 1, "MaxJogadoresPorCampanha": 2 },
      "Standard": { "Nome": "Standard", "MaxCampanhas": 3, "MaxJogadoresPorCampanha": 6 },
      "Vip": { "Nome": "VIP", "MaxCampanhas": 10, "MaxJogadoresPorCampanha": 10 },
      "Ultra": { "Nome": "Ultra", "MaxCampanhas": null, "MaxJogadoresPorCampanha": null }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
