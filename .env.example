# Copie para .env (que NÃO deve ser commitado) e preencha.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
# Domínio principal (o site fica nele e a API em api.<domínio>)
DOMAIN=wyvern.sbs
# Origem do frontend permitida pelo CORS
FRONTEND_ORIGIN=https://wyvern.sbs
# E-mail (confirmação de cadastro) via SMTP do Brevo: painel Brevo > SMTP e API > SMTP.
# EMAIL_USUARIO é o login SMTP mostrado lá (algo como xxxx@smtp-brevo.com), não o e-mail do remetente.
# EMAIL_SENHA é a chave SMTP (não a senha da conta Brevo).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORTA=587
EMAIL_USUARIO=login-smtp-do-brevo
EMAIL_SENHA=chave-smtp-do-brevo
EMAIL_REMETENTE=noreply@wyvern.sbs
